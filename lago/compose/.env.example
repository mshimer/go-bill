# Copy to .env, then append a generated RSA key - see the note at the bottom.
#   cp .env.example .env
#
# .env is gitignored; this file is not, so it must never hold a real secret.

# --- ports on the host ---
LAGO_API_PORT=3000
LAGO_FRONT_PORT=8088

# --- database ---
POSTGRES_USER=lago
POSTGRES_PASSWORD=lago
POSTGRES_DB=lago

# --- the seeded organization ---
# These are the UI login, and LAGO_ORG_API_KEY is the bearer token for the API.
# Lago enforces no format on the key: signup.rake writes this exact string.
LAGO_ORG_NAME=go-bill
LAGO_ORG_USER_EMAIL=go-bill@example.local
LAGO_ORG_USER_PASSWORD=Go-Bill-Local-1!
LAGO_ORG_API_KEY=go-bill-local-api-key

# --- secrets ---
# Lago validates no format on these; local-only throwaways are fine.
SECRET_KEY_BASE=go-bill-local-secret-key-base
LAGO_ENCRYPTION_PRIMARY_KEY=go-bill-local-encryption-primary-key
LAGO_ENCRYPTION_DETERMINISTIC_KEY=go-bill-local-encryption-deterministic-key
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=go-bill-local-encryption-derivation-salt

# Lago signs webhooks with this and has no default for it, so the API will not
# boot without it. It is left empty here rather than committing a key; generate
# one into your .env with:
#
#   printf 'LAGO_RSA_PRIVATE_KEY=%s\n' "$(openssl genrsa 2048 2>/dev/null | openssl base64 -A)" >> .env
#
# The Go stack in container.go generates its own with crypto/rsa instead.
# Intentionally not assigned here: appending is the only definition.
